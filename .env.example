# Copy to .env and fill in SITE_URL. The build reads this file itself
# (`npm run build`, `npm run deploy`); `npm run deploy:s3` loads it through
# dotenv. The shell, and CI's vars.SITE_URL, take precedence over it.

# --- Site ---
# Where the site is published. Required to build: it's the origin for every
# absolute URL the build emits — canonicals, the hreflang cluster, og:url,
# the sitemap, llms.txt — and the CNAME file for GitHub Pages is its host.
# An origin only, no path. `npm run build` refuses to run without it.
SITE_URL=https://your-domain.example

# --- S3-compatible deploy: AWS S3, DigitalOcean Spaces, Yandex Object Storage ---
# Only `npm run deploy:s3` uses these. The providers differ by endpoint:
#   AWS S3                 leave S3_ENDPOINT blank
#   DigitalOcean Spaces    https://<region>.digitaloceanspaces.com   (S3_REGION e.g. fra1)
#   Yandex Object Storage  https://storage.yandexcloud.net           (S3_REGION ru-central1)
# The bucket needs static-website hosting with index.html as the index
# document and 404.html as the error document (on DigitalOcean, a CDN or
# Cloudflare in front for the custom domain).
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# Keys in the bucket the deploy must neither upload nor delete — typically
# search-engine ownership proofs (Yandex Webmaster's yandex_*.html, Bing's
# BingSiteAuth.xml, an IndexNow key file). Space-separated glob patterns;
# each becomes an --exclude, so `--delete` leaves them alone. Blank for none.
S3_KEEP=""

# Read by aws-cli itself. Leave blank to use ~/.aws/credentials instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cloudflare deploy ---
# Only `npm run deploy:cf` uses these (read by wrangler); not needed when
# Cloudflare builds from the repo. Where to get them: docs/deploy.md.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Everything else — name, bio, socials, themes, locales, the now-playing
# endpoint — lives in profile.config.ts, not here. The bundle is public,
# so nothing in it is secret anyway.
