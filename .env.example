# Copy to .env. Only `npm run deploy:s3` reads this file —
# `npm run deploy` (GitHub Pages) needs none of it.

# --- S3-compatible deploy: AWS S3 or Yandex Object Storage ---
# The two differ only by endpoint; leave S3_ENDPOINT blank for AWS.
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# Read by aws-cli itself. Leave blank to use ~/.aws/credentials instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Site ---
# Absolute URLs for the OG image and JSON-LD. Must agree with
# identity.domain in profile.config.ts — `npm run check` fails if not.
SITE_URL=https://terminal.nikita.sh

# Everything else — name, bio, socials, themes, locales, the now-playing
# endpoint — lives in profile.config.ts, not here. The bundle is public,
# so nothing in it is secret anyway.
