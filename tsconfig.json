{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports carry their .ts extension so Vite's native config loader
    // (Node's own TS stripping, the next default) can resolve them.
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vitest/globals", "node"],

    "strict": true,
    "noUnusedParameters": true,
    // `_name` marks an intentionally-unused parameter
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "profile.config.ts", "vite.config.ts", "vitest.config.ts"]
}
